# Optional advanced configuration. start_jev.py prompts without a .env file.
# If using this file, load it explicitly (for example, uv run --env-file .env).
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=typesafe/jev-1.14
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
DEFAULT_SYMBOL=BTC/USD
JEV_MIN_INTERVAL_S=4
JEV_MIN_GAP_S=3
JEV_MATERIAL_MOVE_BPS=15
JEV_MAX_JUDGMENT_AGE_S=10
# irl --use-env uses these SEPARATE keys; paper keys above are never reused.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
# Deliberately disabled. Set explicitly only when you choose live trading.
# JEV_LOOP_ALLOW_LIVE=i-understand-the-risk
